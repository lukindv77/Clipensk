<Window
    x:Class="Clipensk.App.JournalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <NavigationView
        x:Name="ShellNavigation"
        IsSettingsVisible="False"
        IsBackButtonVisible="Collapsed"
        SelectionChanged="OnSelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="JournalItem" Tag="journal">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Paste" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="ApplicationsItem" Tag="applications">
                <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="MaintenanceItem" Tag="maintenance">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="SettingsItem" Tag="settings">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AboutItem" Tag="about">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Grid Padding="24">
            <StackPanel x:Name="FirstRunPanel" Spacing="14" MaxWidth="680" HorizontalAlignment="Left">
                <TextBlock x:Name="FirstRunTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="FirstRunBody" TextWrapping="Wrap" />
                <Button x:Name="ChooseDataRootButton" HorizontalAlignment="Left" Click="OnChooseDataRootClicked" />
                <InfoBar x:Name="DataRootInfo" IsOpen="False" IsClosable="True" />
            </StackPanel>

            <StackPanel x:Name="LockPanel" Spacing="14" MaxWidth="680" HorizontalAlignment="Left" Visibility="Collapsed">
                <TextBlock x:Name="LockTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="LockBody" TextWrapping="Wrap" />

                <StackPanel x:Name="PasswordHintDisplayPanel" Spacing="4">
                    <TextBlock x:Name="PasswordHintTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="PasswordHintValue" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="PasswordSetupHintPanel" Spacing="6" Visibility="Collapsed">
                    <TextBlock x:Name="PasswordSetupHintLabel" />
                    <TextBox x:Name="PasswordHintEditor" Width="460" HorizontalAlignment="Left" />
                </StackPanel>

                <PasswordBox x:Name="PasswordEntry" Width="360" HorizontalAlignment="Left" PasswordRevealMode="Peek" />

                <StackPanel x:Name="PasswordConfirmationPanel" Spacing="6" Visibility="Collapsed">
                    <TextBlock x:Name="PasswordConfirmationLabel" />
                    <PasswordBox x:Name="PasswordConfirmationEntry" Width="360" HorizontalAlignment="Left" PasswordRevealMode="Peek" />
                </StackPanel>

                <Button x:Name="UnlockButton" HorizontalAlignment="Left" Click="OnUnlockClicked" />
                <InfoBar x:Name="LockInfo" IsOpen="False" IsClosable="True" />
            </StackPanel>

            <StackPanel x:Name="PlaceholderPanel" Spacing="12" Visibility="Collapsed">
                <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="PageBody" TextWrapping="Wrap" />
                <TextBlock x:Name="JournalPolicyStatus" TextWrapping="Wrap" />
                <Button x:Name="OpenGlobalPolicyButton" HorizontalAlignment="Left" Click="OnOpenGlobalPolicyClicked" />

                <StackPanel x:Name="JournalContentPanel"
                            Spacing="12"
                            Visibility="Collapsed"
                            Loaded="OnJournalContentPanelLoaded">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CalendarDatePicker x:Name="JournalStartDate"
                                            DateChanged="OnJournalPeriodChanged" />
                        <CalendarDatePicker x:Name="JournalEndDate"
                                            DateChanged="OnJournalPeriodChanged" />
                        <Button x:Name="JournalLoadButton"
                                VerticalAlignment="Bottom"
                                Click="OnJournalLoadClicked" />
                    </StackPanel>
                    <InfoBar x:Name="JournalInfo"
                             IsOpen="False"
                             IsClosable="True" />
                    <ProgressRing x:Name="JournalProgress"
                                  IsActive="False"
                                  Visibility="Collapsed"
                                  Width="28"
                                  Height="28"
                                  HorizontalAlignment="Left" />
                    <ListView x:Name="JournalEntriesList"
                              SelectionMode="None"
                              MaxHeight="520"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4" Margin="0,8">
                                    <TextBlock Text="{Binding TimestampText}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SourceText}" Opacity="0.72" />
                                    <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DetailsText}" TextWrapping="Wrap" Opacity="0.65" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:Name="JournalLoadMoreButton"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            Click="OnJournalLoadMoreClicked" />
                </StackPanel>

                <StackPanel x:Name="MaintenanceContentPanel"
                            Spacing="12"
                            Visibility="Collapsed"
                            MaxWidth="760"
                            HorizontalAlignment="Left"
                            Loaded="OnMaintenanceContentPanelLoaded">
                    <TextBlock x:Name="MaintenanceBody" TextWrapping="Wrap" />
                    <InfoBar x:Name="MaintenanceInfo"
                             IsOpen="False"
                             IsClosable="True" />
                    <ProgressRing x:Name="MaintenanceProgress"
                                  IsActive="False"
                                  Visibility="Collapsed"
                                  Width="28"
                                  Height="28"
                                  HorizontalAlignment="Left" />
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="MaintenanceArchiveLabel"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ComboBox x:Name="MaintenanceArchiveSelector"
                                  Width="520"
                                  HorizontalAlignment="Left"
                                  DisplayMemberPath="DisplayText"
                                  SelectionChanged="OnMaintenanceArchiveSelectionChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <CalendarDatePicker x:Name="MaintenanceStartDate"
                                            DateChanged="OnMaintenanceDateChanged" />
                        <CalendarDatePicker x:Name="MaintenanceEndDate"
                                            DateChanged="OnMaintenanceDateChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="MaintenanceValidateCatalogButton"
                                IsEnabled="False"
                                Click="OnMaintenanceValidateCatalogClicked" />
                        <Button x:Name="MaintenanceValidateButton"
                                IsEnabled="False"
                                Click="OnMaintenanceValidateClicked" />
                        <Button x:Name="MaintenanceTransferButton"
                                IsEnabled="False"
                                Click="OnMaintenanceTransferClicked" />
                        <Button x:Name="MaintenanceReloadButton"
                                Click="OnMaintenanceReloadClicked" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <ScrollViewer x:Name="GlobalPolicyPanel" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20" MaxWidth="760" HorizontalAlignment="Stretch">
                    <StackPanel x:Name="ApplicationPoliciesPanel" Spacing="12" Loaded="OnApplicationPoliciesPanelLoaded">
                        <TextBlock x:Name="ApplicationPoliciesTitle" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ApplicationPoliciesBody" TextWrapping="Wrap" />
                        <InfoBar x:Name="ApplicationPoliciesInfo" IsOpen="False" IsClosable="True" />
                        <ProgressRing x:Name="ApplicationPoliciesProgress" IsActive="False" Visibility="Collapsed"
                                      Width="28" Height="28" HorizontalAlignment="Left" />
                        <ListView x:Name="ApplicationPoliciesList"
                                  SelectionChanged="OnApplicationPolicySelectionChanged"
                                  DisplayMemberPath="DisplayName"
                                  MaxHeight="280" />
                        <TextBlock x:Name="SelectedApplicationIdentity" TextWrapping="Wrap" />
                        <TextBlock x:Name="SelectedApplicationPolicySummary" TextWrapping="Wrap" />
                        <StackPanel x:Name="SelectedApplicationDiscoveredFormatsPanel"
                                    Spacing="4"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="SelectedApplicationDiscoveredFormatsTitle"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="SelectedApplicationDiscoveredFormats" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="EditApplicationPolicyButton"
                                    IsEnabled="False"
                                    Click="OnEditApplicationPolicyClicked" />
                            <Button x:Name="EditApplicationFormatsButton"
                                    IsEnabled="{Binding IsEnabled, ElementName=EditApplicationPolicyButton}"
                                    Loaded="OnEditApplicationFormatsButtonLoaded"
                                    Click="OnEditApplicationFormatsClicked" />
                            <Button x:Name="ReloadApplicationPoliciesButton" Click="OnReloadApplicationPoliciesClicked" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="GlobalPolicyTitle" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock x:Name="GlobalPolicyBody" TextWrapping="Wrap" />
                    <InfoBar x:Name="GlobalPolicyInfo" IsOpen="True" IsClosable="False" />
                    <ProgressRing x:Name="GlobalPolicyProgress" IsActive="False" Visibility="Collapsed"
                                  Width="28" Height="28" HorizontalAlignment="Left" />
                    <ContentControl x:Name="GlobalPolicyEditor" Visibility="Collapsed"
                                    HorizontalContentAlignment="Stretch" IsTabStop="False">
                        <StackPanel Spacing="16">
                            <ComboBox x:Name="GlobalPolicyRule" HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="GlobalPolicyFormatsTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <StackPanel x:Name="GlobalPolicyFormatRows" Spacing="16" />
                            <TextBlock x:Name="GlobalPolicyLimitsHelp" TextWrapping="Wrap" />
                            <TextBlock x:Name="GlobalPolicyExternalHelp" TextWrapping="Wrap" />
                            <TextBlock x:Name="GlobalPolicySetupHelp" TextWrapping="Wrap" />
                            <Button x:Name="SaveGlobalPolicyButton" HorizontalAlignment="Left" Click="OnSaveGlobalPolicyClicked" />
                        </StackPanel>
                    </ContentControl>
                    <TextBlock x:Name="GlobalPolicySummary" TextWrapping="Wrap" Visibility="Collapsed" />
                    <Button x:Name="EditGlobalPolicyButton"
                            HorizontalAlignment="Left"
                            Visibility="{Binding Visibility, ElementName=GlobalPolicySummary}"
                            Loaded="OnEditGlobalPolicyButtonLoaded"
                            Click="OnEditGlobalPolicyClicked" />
                    <Button x:Name="ReloadGlobalPolicyButton" HorizontalAlignment="Left" Click="OnReloadGlobalPolicyClicked" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="SettingsPanel" Spacing="16" Visibility="Collapsed">
                <TextBlock x:Name="SettingsTitle" Style="{StaticResource TitleTextBlockStyle}" />

                <StackPanel Spacing="4">
                    <TextBlock x:Name="DataRootTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="DataRootValue" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock x:Name="HotKeyTitle" Style="{StaticResource SubtitleTextBlockStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox x:Name="ControlModifier" Content="Ctrl" />
                    <CheckBox x:Name="AltModifier" Content="Alt" />
                    <CheckBox x:Name="ShiftModifier" Content="Shift" />
                    <CheckBox x:Name="WindowsModifier" Content="Win" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock x:Name="HotKeyKeyLabel" />
                    <ComboBox x:Name="HotKeyKey" Width="180" HorizontalAlignment="Left" DisplayMemberPath="DisplayName" />
                </StackPanel>

                <Button x:Name="ApplyHotKeyButton" HorizontalAlignment="Left" Click="OnApplyHotKeyClicked" />
                <InfoBar x:Name="HotKeyInfo" IsOpen="False" IsClosable="True" />
            </StackPanel>
        </Grid>
    </NavigationView>
</Window>